<!DOCTYPE html>
<html>
<head>
    <title>Promise Chain</title>
</head>
<body>

    <h1 id="result"></h1>

    <script src="main.js"></script>
</body>
</html>
//JS
function task1() {
    return new Promise((resolve) => {
        setTimeout(() => {
            resolve("Task 1 completed");
        }, 1000);
    });
}

function task2() {
    return new Promise((resolve) => {
        setTimeout(() => {
            resolve("Task 2 completed");
        }, 1000);
    });
}

function task3() {
    return new Promise((resolve) => {
        setTimeout(() => {
            resolve("Task 3 completed");
        }, 1000);
    });
}

task1()
    .then((message) => {
        console.log(message);
        return task2();
    })
    .then((message) => {
        console.log(message);
        return task3();
    })
    .then((message) => {
        console.log(message);
        document.getElementById("result").textContent = message;
    });
//KEYWORDS
task1()
  ↓ 1 sekund
.then()
  ↓
task2()
  ↓ 1 sekund
.then()
  ↓
task3()
  ↓ 1 sekund
.then()
Promise
  ↓
.then()
  ↓
return Promise
  ↓
.then()
  ↓
return Promise
  ↓
.then()
Promise → asynchronous amal
.then() → Promise natijasidan keyingi amal
return → keyingi .then()ga qiymat yuboradi
setTimeout → vaqt kutish
Promise Chain → bir nechta .then()ni ketma-ket ulash
