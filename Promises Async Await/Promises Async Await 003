<!DOCTYPE html>
<html>
<head>
    <title>Promise Rejection</title>
</head>
<body>

    <h1 id="result"></h1>

    <script src="main.js"></script>
</body>
</html>
//JS
function checkData() {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            reject("Something went wrong!");
        }, 1000);
    });
}

checkData()
    .then((message) => {
        document.getElementById("result").textContent = message;
    })
    .catch((error) => {
        document.getElementById("result").textContent = error;
    });

//KEYWORDS
             Promise
             /     \
        resolve    reject
           ↓         ↓
        .then()   .catch()
Promise → asynchronous amal
resolve → muvaffaqiyatli natija
reject → xato / muvaffaqiyatsiz natija
.catch() → xatoni ushlaydi
error → xato
