<!DOCTYPE html>
<html>
<head>
    <title>Promise.any()</title>
</head>
<body>

    <h1 id="result"></h1>

    <script src="main.js"></script>
</body>
</html>
//JS
function task1() {
    return new Promise((resolve) => {
        setTimeout(() => {
            resolve("Task 1 successful");
        }, 3000);
    });
}

function task2() {
    return new Promise((resolve) => {
        setTimeout(() => {
            resolve("Task 2 successful");
        }, 1000);
    });
}

function task3() {
    return new Promise((resolve) => {
        setTimeout(() => {
            resolve("Task 3 successful");
        }, 2000);
    });
}

Promise.any([task1(), task2(), task3()])
    .then((result) => {
        document.getElementById("result").textContent = result;
    })
    .catch((error) => {
        document.getElementById("result").textContent = "All promises failed";
    });
//KEYWORD
Promise 1 → 3 sekund → resolve
Promise 2 → 1 sekund → resolve ✅
Promise 3 → 2 sekund → resolve
Promise.any() → birinchi successful Promise natijasini oladi
resolve → muvaffaqiyatli tugash
reject → xato bilan tugash
.catch() → hammasi xato bo‘lsa ishlaydi
setTimeout() → vaqt kutish
