//JS
function string_endsWith(text, word) {
    if (word == "") {
        return false;
    } else {
        return text.endsWith(word);
    }
}

console.log(string_endsWith("JS PHP PYTHON", "PYTHON"));
console.log(string_endsWith("JS PHP PYTHON", ""));
