//JS
function uncamelize(text, symbol) {
    if (symbol == undefined) {
        symbol = " ";
    }

    return text.replace(/[A-Z]/g, x => symbol + x.toLowerCase());
}

console.log(uncamelize("helloWorld"));
console.log(uncamelize("helloWorld", "-"));
console.log(uncamelize("helloWorld", "_"));
