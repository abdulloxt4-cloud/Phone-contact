//JS
function ascii_to_hexa(text) {
    let result = "";

    for (let i = 0; i < text.length; i++) {
        result += text.charCodeAt(i).toString(16);
    }

    return result;
}

console.log(ascii_to_hexa("12"));
console.log(ascii_to_hexa("100"));
