//JS
function remove_first_occurrence(text, word) {
    let pos = text.toLowerCase().indexOf(word.toLowerCase());

    if (pos == -1) {
        return text;
    } else {
        return text.slice(0, pos) + text.slice(pos + word.length);
    }
}

console.log(remove_first_occurrence(
    "The quick brown fox jumps over the lazy dog",
    "the"
));
