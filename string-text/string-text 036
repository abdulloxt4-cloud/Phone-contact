//JS
function zeroFill(num, length, sign) {
    let number = String(num);

    if (sign == "-") {
        number = "+" + number;
    }

    return number.padStart(length, "0");
}

console.log(zeroFill(120, 5, "-"));
console.log(zeroFill(29, 4));
