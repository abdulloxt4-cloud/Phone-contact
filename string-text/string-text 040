//JS
function unCapitalize_Words(text) {
    let words = text.split(" ");

    for (let i = 0; i < words.length; i++) {
        words[i] = words[i].charAt(0).toLowerCase() + words[i].slice(1);
    }

    return words.join(" ");
}

console.log(unCapitalize_Words("Js String Exercises"));
