//JS

function consecutiveSum(num) {

    for (let i = 1; i < num; i++) {

        let sum = 0;

        for (let j = i; j < num; j++) {

            sum = sum + j;

            if (sum == num) {
                return true;
            }

            if (sum > num) {
                break;
            }
        }
    }

    return false;
}

console.log(consecutiveSum(33));
console.log(consecutiveSum(10));
console.log(consecutiveSum(8));

