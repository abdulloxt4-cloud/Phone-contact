//CSS
html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    color: #111;
}

.section {
    padding: 90px 0;
}

.section-number {
    font-size: 14px;
    font-weight: bold;
    color: #777;
    margin-bottom: 5px;
}

.section-title {
    font-size: 42px;
    font-weight: bold;
    margin-bottom: 45px;
}

.navbar {
    padding: 15px 0;
}

.navbar-brand {
    font-size: 25px;
}

.hero {
    background-color: #f5f5f5;
}

.small-title {
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 4px;
}

.hero-text {
    max-width: 650px;
}

.profile-img {
    width: 360px;
    height: 360px;
    object-fit: cover;
    border-radius: 50%;
    border: 10px solid white;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
}

.about-text {
    font-size: 20px;
    line-height: 1.8;
}

.education-card {
    background-color: white;
    padding: 35px;
    border-left: 5px solid #111;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.07);
}

.education-year {
    font-size: 28px;
    font-weight: bold;
}

.skill-card {
    height: 100%;
    padding: 35px 20px;
    text-align: center;
    border: 1px solid #ddd;
    border-radius: 10px;
    transition: 0.3s;
}

.skill-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

.skill-card i {
    font-size: 45px;
}

.skill-card h4 {
    margin-top: 20px;
}

.skill-card p {
    color: #777;
    margin-bottom: 0;
}

.knowledge-card {
    height: 100%;
    background-color: white;
    padding: 30px;
    border-radius: 10px;
    border: 1px solid #ddd;
}

.knowledge-card i {
    margin-right: 8px;
}

.language-card {
    padding: 30px;
    border: 1px solid #ddd;
    border-radius: 10px;
}

.language-card p {
    color: #777;
}

.progress {
    height: 7px;
}

.contact-section {
    background-color: #111;
}

.contact-item {
    color: white;
}

.contact-item i {
    font-size: 30px;
}

.contact-item p {
    margin-top: 15px;
    margin-bottom: 5px;
    color: #aaa;
}

.contact-item a {
    color: white;
    text-decoration: none;
}

.contact-item span {
    color: white;
}

footer {
    background-color: #000;
    color: #aaa;
    text-align: center;
    padding: 25px 0;
}

.dark-mode {
    background-color: #121212;
    color: white;
}

.dark-mode .hero,
.dark-mode .bg-light {
    background-color: #1b1b1b !important;
}

.dark-mode .education-card,
.dark-mode .knowledge-card,
.dark-mode .skill-card,
.dark-mode .language-card {
    background-color: #242424;
    color: white;
    border-color: #444;
}

.dark-mode .education-card {
    border-left-color: white;
}

.dark-mode .text-secondary {
    color: #aaa !important;
}

.dark-mode .btn-outline-dark {
    color: white;
    border-color: white;
}

.dark-mode .btn-outline-dark:hover {
    background-color: white;
    color: black;
}

@media (max-width: 768px) {

    .hero {
        padding-top: 80px;
        padding-bottom: 60px;
    }

    .profile-img {
        width: 230px;
        height: 230px;
    }

    .hero h1 {
        font-size: 50px;
    }

    .hero h3 {
        font-size: 21px;
    }

    .section {
        padding: 60px 0;
    }

    .section-title {
        font-size: 34px;
    }

    .about-text {
        font-size: 17px;
    }

    .education-year {
        display: block;
        margin-bottom: 20px;
    }

    .contact-item {
        text-align: center;
        margin-bottom: 20px;
    }

}
//JS
const themeBtn = document.getElementById("themeBtn");

themeBtn.addEventListener("click", function () {

    document.body.classList.toggle("dark-mode");

    const icon = themeBtn.querySelector("i");

    icon.classList.toggle("bi-moon-fill");
    icon.classList.toggle("bi-sun-fill");

});
