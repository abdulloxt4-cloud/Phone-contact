//JS
function add(a, b) {
    return a + b;
}

export { add };
function greet(name) {
    return `Hello, ${name}!`;
}

export { greet };
export { add } from "./math.js";
export { greet } from "./greet.js";
import { add, greet } from "./index.js";

let result = `
    ${greet("Abdulloh")} <br>
    Qo‘shish: ${add(10, 5)}
`;

document.getElementById("result").innerHTML = result;
