  //JS
  function greet(name) {
    return `Hello, ${name}!`;
}

function add(a, b) {
    return a + b;
}

function multiply(a, b) {
    return a * b;
}

export default greet;
export { add, multiply };
import greet, { add, multiply } from "./math.js";

let result = `
    ${greet("Abdulloh")} <br>
    Qo‘shish: ${add(10, 5)} <br>
    Ko‘paytirish: ${multiply(10, 5)}
`;

document.getElementById("result").innerHTML = result;
