from datetime import date
birth_year = int(input("Tug'ilgan yilingizni kiriting: "))

current_year = date.today().year

age = current_year - birth_year

print(f"Siz {birth_year}-yilda tug'ilgansiz.")
print(f"Siz bu yil {age} yoshga to'lasiz.")
//javob
Tug'ilgan yilingizni kiriting: 2006
Siz 2006-yilda tug'ilgansiz.
Siz bu yil 20 yoshga to'lasiz.

