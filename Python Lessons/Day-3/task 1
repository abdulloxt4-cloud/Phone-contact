n = int(input("Son kiriting: "))
total = 0
factorial = 1
if n < 0:
    print("Musbat son yoki 0 kiriting!")
else:
    for i in range(1, n + 1):
        total += i
        factorial *= i
    print(f"Yig'indi: {total}")
    print(f"Faktorial: {factorial}")

