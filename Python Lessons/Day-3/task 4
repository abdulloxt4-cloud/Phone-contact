import random
secret = random.randint(1, 100)
attempts = 0
print("Sonni top o'yiniga xush kelibsiz!")
while True:
    guess = int(input("Son kiriting (1-100): "))

    if guess < 1 or guess > 100:
        print("1 dan 100 gacha son kiriting!")
        continue

    attempts += 1

    if guess < secret:
        print("Kattaroq son kiriting!")
    elif guess > secret:
        print("Kichikroq son kiriting!")
    else:
        print("Tabriklayman! Sonni topdingiz!")
        print(f"Urinishlar soni: {attempts}")
        break
