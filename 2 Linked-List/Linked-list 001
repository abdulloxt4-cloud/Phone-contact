//JS
let node1 = { value: 10, prev: null, next: null };
let node2 = { value: 20, prev: node1, next: null };
let node3 = { value: 30, prev: node2, next: null };

node1.next = node2;
node2.next = node3;

console.log(node1);

document.getElementById("result").innerHTML = "10 ⇄ 20 ⇄ 30";
