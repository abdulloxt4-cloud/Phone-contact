//JS
function power_of_four(num) {

    if (typeof num != "number") {
        return "It must be number!";
    } else if (num <= 0) {
        return false;
    } else if ((num & (num - 1)) != 0) {
        return false;
    } else if (num % 4 != 0) {
        return false;
    } else {
        return true;
    }
}

console.log(power_of_four(256));
console.log(power_of_four(4));
console.log(power_of_four(2));
console.log(power_of_four("16"));
