//JS
function next_power_of_two(num) {

    if (typeof num != "number") {
        return "It must be number!";
    }

    let power = 1;

    while (power < num) {
        power = power * 2;
    }

    return power;
}

console.log(next_power_of_two(1));
console.log(next_power_of_two(4));
console.log(next_power_of_two(9));
console.log(next_power_of_two("15"));
