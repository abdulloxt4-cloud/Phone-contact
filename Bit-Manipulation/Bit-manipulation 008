//JS
function binary_log(num) {

    let count = 0;

    while (num > 1) {
        num = num >> 1;
        count++;
    }

    return count;
}

console.log(binary_log(1));
console.log(binary_log(2));
console.log(binary_log(4));
console.log(binary_log(32));

