//JS
function swap_bits(num, p1, p2) {

    let bit1 = (num >> p1) & 1;
    let bit2 = (num >> p2) & 1;

    if (bit1 != bit2) {
        num = num ^ (1 << p1);
        num = num ^ (1 << p2);
    } else if (bit1 == bit2) {
        return num;
    }

    return num;
}

console.log(swap_bits(245, 2, 1));
