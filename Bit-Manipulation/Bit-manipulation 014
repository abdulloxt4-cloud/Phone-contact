//JS
function non_repeated(arr) {

    let result = 0;

    for (let num of arr) {
        result = result ^ num;
    }

    if (arr.length == 1) {
        return arr[0];
    } else if (result == 0) {
        return 0;
    } else {
        return result;
    }
}

console.log(non_repeated([1]));
console.log(non_repeated([1, 2, 3]));
console.log(non_repeated([1, 2, 8, 3, 1, 2, 3, 8, 6, 6, 7]));
