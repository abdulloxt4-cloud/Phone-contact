//JS
function count_zero_bits(num) {

    if (!Number.isInteger(num)) {
        return "Parameter value is not an Integer!";
    }

    let binary = num.toString(2);
    let count = 0;

    for (let bit of binary) {
        if (bit == "0") {
            count++;
        }
    }

    return count;
}

console.log(count_zero_bits(45));
console.log(count_zero_bits(17));
console.log(count_zero_bits(15.5));
