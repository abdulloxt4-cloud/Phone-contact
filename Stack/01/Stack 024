//JS
let stack1 = [10, 20, 30];
let stack2 = [40, 50, 60];

let stack = stack1.concat(stack2);

console.log(stack);

document.getElementById("result").innerHTML = stack;

//OZIM UCHUN
Concat    → birlashtirish
Stack     → Stack
stack1    → birinchi Stack
stack2    → ikkinchi Stack
concat()  → ikkisini birlashtiradi

Stack 1 → [10, 20, 30]
Stack 2 → [40, 50, 60]

        ↓ concat()

New Stack → [10, 20, 30, 40, 50, 60]
