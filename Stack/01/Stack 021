//JS
let stack = {
    top: null,
    next: null
};

stack.top = 10;
stack.next = 20;

let removed = stack.top;
stack.top = stack.next;

let empty = stack.top == null;

console.log(removed);
console.log(stack.top);
console.log(empty);

document.getElementById("result").innerHTML =
    removed + "<br>" +
    stack.top + "<br>" +
    empty;

