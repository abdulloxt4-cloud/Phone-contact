//JS
let stack1 = [10, 20, 30];
let stack2 = [30, 40, 50];

let stack = stack1.concat(stack2);

let result = stack.filter((element, index) => stack.indexOf(element) == index);

console.log(result);

document.getElementById("result").innerHTML = result;
