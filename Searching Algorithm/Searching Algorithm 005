//JS
function interpolationSearch(arr, value) {

    let low = 0;
    let high = arr.length - 1;

    while (low <= high && value >= arr[low] && value <= arr[high]) {

        let pos = Math.floor(
            low + ((value - arr[low]) * (high - low)) /
            (arr[high] - arr[low])
        );

        if (arr[pos] == value) {
            return pos;
        }

        if (arr[pos] < value) {
            low = pos + 1;
        } else {
            high = pos - 1;
        }
    }

    return -1;
}

let numbers = [1, 7, 13, 14, 15, 26, 37, 48, 99, 110];

let result = interpolationSearch(numbers, 99);

document.getElementById("result").innerHTML = result;
