//JS
function findIndexes(text, word) {

    let indexes = [];

    for (let i = 0; i <= text.length - word.length; i++) {

        if (text.substring(i, i + word.length) == word) {
            indexes.push(i);
        }
    }

    return indexes;
}

let text = "the quick brown fox jumps over the lazy dog.";
let word = "the";

let result = findIndexes(text, word);

document.getElementById("result").innerHTML = result;
