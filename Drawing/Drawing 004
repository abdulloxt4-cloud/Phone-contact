<!DOCTYPE html>
<html>
<head>
    <title>Right Angled Triangle</title>
</head>
<body>

    <canvas id="canvas" width="300" height="250"></canvas>

    <script src="main.js"></script>

</body>
</html>
//JS
let canvas = document.getElementById("canvas");
let ctx = canvas.getContext("2d");

ctx.beginPath();

ctx.moveTo(50, 200);
ctx.lineTo(50, 50);
ctx.lineTo(200, 200);
ctx.closePath();

ctx.stroke();
//SELF
moveTo() → boshlanish nuqtasiga boradi
lineTo() → chiziq chizadi
closePath() → oxirgi nuqtani boshlang‘ich nuqtaga ulaydi
stroke() → chiziqlarni ko‘rsatadi
canvas → chizish joyi
getContext("2d") → 2D rejim
beginPath() → chizishni boshlaydi
moveTo() → nuqtaga boradi
lineTo() → chiziq chizadi
closePath() → shaklni yopadi
stroke() → chiziqni chiqaradi
