<!DOCTYPE html>
<html>
<head>
    <title>Regex Trim</title>
</head>
<body>

    <h2>Regex Trim Function</h2>

    <input id="text" placeholder="Enter text">
    <button onclick="trimText()">Trim</button>

    <p id="result"></p>

    <script src="main.js"></script>
</body>
</html>
//JS
function trimText() {
    let text = document.getElementById("text").value;

    let result = text.replace(/^\s+|\s+$/g, "");

    document.getElementById("result").innerHTML = result;
}
//SELF
^      → boshidan
\s+    → bir yoki undan ko‘p bo‘sh joy
|      → yoki
$      → oxiri
g      → hammasini qidir
"   Salom   " → "Salom"
