<!DOCTYPE html>
<html>
<head>
    <title>Count Words</title>
</head>
<body>

    <h2>Count Words</h2>

    <input id="text" placeholder="Enter text">
    <button onclick="countWords()">Count</button>

    <p id="result"></p>

    <script src="main.js"></script>
</body>
</html>
//JS
function countWords() {
    let text = document.getElementById("text").value;

    text = text.trim().replace(/\s+/g, " ");

    let result = text.split(" ").length;

    document.getElementById("result").innerHTML = result;
}
//SELF
\s → space, tab, newline kabi whitespace
+ → 1 yoki undan ko‘p
g → hammasini qidiradi.
