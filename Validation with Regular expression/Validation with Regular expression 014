<!DOCTYPE html>
<html>
<head>
    <title>Canada Post Code</title>
</head>
<body>

    <h2>Validate Canada Post Code</h2>

    <input id="postcode" placeholder="A1A 1A1">
    <button onclick="checkPostcode()">Check</button>

    <p id="result"></p>

    <script src="main.js"></script>
</body>
</html>
//JS
function checkPostcode() {
    let postcode = document.getElementById("postcode").value;

    let result = /^[A-Z]\d[A-Z] \d[A-Z]\d$/i.test(postcode);

    document.getElementById("result").innerHTML = result;
}
