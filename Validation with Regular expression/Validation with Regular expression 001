<!DOCTYPE html>
<html>
<head>
    <title>Check Uppercase First</title>
</head>
<body>

    <h2>Check Uppercase First</h2>

    <input id="text" placeholder="Enter text">
    <button onclick="check()">Check</button>

    <p id="result"></p>

    <script src="main.js"></script>
</body>
</html>
//JS
function check() {
    let text = document.getElementById("text").value;

    let result = /^[A-Z]/.test(text);

    document.getElementById("result").innerHTML = result;
}
//SELF
^       → string boshidan
[A-Z]   → katta harf
.test() → tekshiradi
//For example 
Abdulloh → true
abdulloh → false
