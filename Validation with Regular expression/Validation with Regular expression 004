<!DOCTYPE html>
<html>
<head>
    <title>Search Date</title>
</head>
<body>

    <h2>Search Date in String</h2>

    <input id="text" placeholder="Enter text">
    <button onclick="searchDate()">Search</button>

    <p id="result"></p>

    <script src="main.js"></script>
</body>
</html>
//JS
function searchDate() {
    let text = document.getElementById("text").value;

    let pattern = /\b\d{2}\/\d{2}\/\d{4}\b/;

    let result = pattern.test(text);

    document.getElementById("result").innerHTML = result;
}
//SELF
\b       → chegara
\d{2}    → 2 ta raqam
\/       → /
\d{2}    → 2 ta raqam
\/       → /
\d{4}    → 4 ta raqam
"Bugun 24/08/2026" → true
"Bugun 24-08-2026" → false
"Bugun sana bor"   → false
