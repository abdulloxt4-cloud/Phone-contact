<!DOCTYPE html>
<html>
<head>
    <title>Check Alphanumeric</title>
</head>
<body>

    <h2>Check Alphanumeric</h2>

    <input id="text" placeholder="Enter text">
    <button onclick="check()">Check</button>

    <p id="result"></p>

    <script src="main.js"></script>
</body>
</html>
//JS
function check() {
    let text = document.getElementById("text").value;

    let result = /^[A-Za-z0-9]+$/.test(text);

    document.getElementById("result").innerHTML = result;
}
//SELF
[A-Za-z] → katta va kichik harflar
[0-9]    → raqamlar
+        → 1 yoki undan ko‘p
^        → boshidan
$        → oxirigacha
Abdulloh123 → true
Hello2026   → true
Hello 123   → false
Hello@123   → false
