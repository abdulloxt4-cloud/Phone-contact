<!DOCTYPE html>
<html>
<head>
    <title>Validate IP Address</title>
</head>
<body>

    <h2>Validate IP Address</h2>

    <input id="ip" placeholder="Enter IP address">
    <button onclick="checkIP()">Check</button>

    <p id="result"></p>

    <script src="main.js"></script>
</body>
</html>
//JS
function checkIP() {
    let ip = document.getElementById("ip").value;

    let pattern = /^(\d{1,3}\.){3}\d{1,3}$/;

    let result = pattern.test(ip);

    document.getElementById("result").innerHTML = result;
}
//SELF
\d{1,3} → 1 dan 3 tagacha raqam
\.       → nuqta
{3}      → 3 marta takrorlanadi
^        → boshidan
$        → oxirigacha
192.168.1.1 → true
10.0.0.1    → true
192.168.1   → false
192.168.1.1.5 → false
