<!DOCTYPE html>
<html>
<head>
    <title>Alpha Dash Underscore</title>
</head>
<body>

    <h2>Alpha Dash Underscore</h2>

    <input id="text" placeholder="Enter text">
    <button onclick="check()">Check</button>

    <p id="result"></p>

    <script src="main.js"></script>
</body>
</html>
//JS
function check() {
    let text = document.getElementById("text").value;

    let result = /^(?=.*[A-Za-z])(?=.*-)(?=.*_).+$/.test(text);

    document.getElementById("result").innerHTML = result;
}
//SELF
[A-Za-z] → harf bor
-        → dash bor
_        → underscore bor
(?=...)  → shu narsa mavjudligini tekshiradi
Abc-_       → true
Hello-World_ → true
Hello_World → false
Hello-World → false
