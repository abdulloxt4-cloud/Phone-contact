//JS
function shellSort(arr) {

    let gap = Math.floor(arr.length / 2);

    while (gap > 0) {

        for (let i = gap; i < arr.length; i++) {

            let temp = arr[i];
            let j = i;

            while (j >= gap && arr[j - gap] > temp) {
                arr[j] = arr[j - gap];
                j = j - gap;
            }

            arr[j] = temp;
        }

        gap = Math.floor(gap / 2);
    }

    return arr;
}

let numbers = [8, 3, 5, 1, 7, 2];

document.getElementById("result").innerHTML = shellSort(numbers);
