//JS
function pancakeSort(arr) {

    for (let size = arr.length; size > 1; size--) {

        let maxIndex = 0;

        // Eng kattasini topish
        for (let i = 1; i < size; i++) {
            if (arr[i] > arr[maxIndex]) {
                maxIndex = i;
            }
        }

        // Eng kattasini boshiga olib kelish
        if (maxIndex != 0) {
            arr.splice(0, maxIndex + 1, ...arr.slice(0, maxIndex + 1).reverse());
        }

        // Eng kattasini oxiriga qo'yish
        arr.splice(0, size, ...arr.slice(0, size).reverse());
    }

    return arr;
}

let numbers = [5, 2, 8, 1, 3];

document.getElementById("result").innerHTML = pancakeSort(numbers);
