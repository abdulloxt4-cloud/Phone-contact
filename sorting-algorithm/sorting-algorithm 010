//JS
function gnomeSort(arr) {

    let i = 1;

    while (i < arr.length) {

        if (i == 0 || arr[i] >= arr[i - 1]) {
            i++;
        } else {

            let temp = arr[i];
            arr[i] = arr[i - 1];
            arr[i - 1] = temp;

            i--;
        }
    }

    return arr;
}

let numbers = [5, 2, 8, 1, 3];

document.getElementById("result").innerHTML = gnomeSort(numbers);
