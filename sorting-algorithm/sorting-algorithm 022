//JS
function lowestInsertIndex(arr, value) {

    for (let i = 0; i < arr.length; i++) {

        if (arr[i] >= value) {
            return i;
        }
    }

    return arr.length;
}

let numbers = [1, 2, 2, 3, 5];

let result = lowestInsertIndex(numbers, 2);

document.getElementById("result").innerHTML = result;
