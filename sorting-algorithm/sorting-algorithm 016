<!DOCTYPE html>
<html>
<head>
    <title>Sort Objects</title>
</head>
<body>

    <h2>Sort Objects by Property</h2>

    <p id="result"></p>

    <script src="main.js"></script>
</body>
</html>
//JS
function sortObjects(arr, property, order) {

    return arr.sort(function(a, b) {

        if (a[property] < b[property]) {
            return order == "asc" ? -1 : 1;
        }

        if (a[property] > b[property]) {
            return order == "asc" ? 1 : -1;
        }

        return 0;
    });
}

let students = [
    { name: "Ali", age: 25 },
    { name: "Vali", age: 20 },
    { name: "Hasan", age: 30 }
];

let result = sortObjects(students, "age", "asc");

document.getElementById("result").innerHTML =
    result.map(student => student.name + " - " + student.age).join("<br>");
