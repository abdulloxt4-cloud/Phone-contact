//JS
function binarySearch(arr, value) {

    let left = 0;
    let right = arr.length - 1;

    while (left <= right) {

        let middle = Math.floor((left + right) / 2);

        if (arr[middle] == value) {
            return middle;
        }

        if (arr[middle] < value) {
            left = middle + 1;
        } else {
            right = middle - 1;
        }
    }

    return -1;
}

let numbers = [1, 3, 5, 7, 9, 11, 15];

let result = binarySearch(numbers, 9);

document.getElementById("result").innerHTML = result;
