//JS
function bucketSort(arr) {

    let min = Math.min(...arr);
    let max = Math.max(...arr);

    let bucketCount = 5;
    let buckets = [];

    // Bucketlarni yaratish
    for (let i = 0; i < bucketCount; i++) {
        buckets.push([]);
    }

    // Sonlarni bucketlarga joylash
    for (let i = 0; i < arr.length; i++) {

        let index = Math.floor(
            ((arr[i] - min) / (max - min + 1)) * bucketCount
        );

        buckets[index].push(arr[i]);
    }

    // Har bir bucketni sort qilish
    for (let i = 0; i < buckets.length; i++) {
        buckets[i].sort((a, b) => a - b);
    }

    // Bucketlarni birlashtirish
    let result = [];

    for (let i = 0; i < buckets.length; i++) {
        result = result.concat(buckets[i]);
    }

    return result;
}

let numbers = [29, 10, 45, 20, 35, 15, 40];

document.getElementById("result").innerHTML = bucketSort(numbers);
