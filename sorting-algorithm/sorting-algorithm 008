<!DOCTYPE html>
<html>
<head>
    <title>Cocktail Sort</title>
</head>
<body>

    <h2>Cocktail Shaker Sort</h2>

    <p id="result"></p>

    <script src="main.js"></script>
</body>
</html>
//JS
function cocktailSort(arr) {

    let start = 0;
    let end = arr.length - 1;

    while (start < end) {

        // Chapdan o'ngga
        for (let i = start; i < end; i++) {
            if (arr[i] > arr[i + 1]) {
                let temp = arr[i];
                arr[i] = arr[i + 1];
                arr[i + 1] = temp;
            }
        }

        end--;

        // O'ngdan chapga
        for (let i = end; i > start; i--) {
            if (arr[i] < arr[i - 1]) {
                let temp = arr[i];
                arr[i] = arr[i - 1];
                arr[i - 1] = temp;
            }
        }

        start++;
    }

    return arr;
}

let numbers = [5, 2, 8, 1, 3];

document.getElementById("result").innerHTML = cocktailSort(numbers);
