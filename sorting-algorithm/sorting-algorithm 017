//JS
function highestIndex(arr, value) {

    let index = 0;

    for (let i = 0; i < arr.length; i++) {

        if (arr[i] <= value) {
            index = i + 1;
        }
    }

    return index;
}

let numbers = [1, 2, 2, 3, 5];

let result = highestIndex(numbers, 2);

document.getElementById("result").innerHTML = result;
