//JS
function combSort(arr) {

    let gap = arr.length;
    let swapped = true;

    while (gap > 1 || swapped) {

        gap = Math.floor(gap / 1.3);

        if (gap < 1) {
            gap = 1;
        }

        swapped = false;

        for (let i = 0; i + gap < arr.length; i++) {

            if (arr[i] > arr[i + gap]) {

                let temp = arr[i];
                arr[i] = arr[i + gap];
                arr[i + gap] = temp;

                swapped = true;
            }
        }
    }

    return arr;
}

let numbers = [5, 2, 8, 1, 3];

document.getElementById("result").innerHTML = combSort(numbers);
