<!DOCTYPE html>
<html>
<head>
    <title>Sort Characters</title>
</head>
<body>

    <h2>Sort Characters in String</h2>

    <p id="result"></p>

    <script src="main.js"></script>

</body>
</html>
//JS
function sortCharacters(str) {

    return str.split("").sort().join("");
}

let text = "javascript";

let result = sortCharacters(text);

document.getElementById("result").innerHTML = result;
