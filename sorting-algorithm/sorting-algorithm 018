<body>

    <h2>Sort Objects by Property Order</h2>

    <p id="result"></p>

    <script src="main.js"></script>

</body>
</html>
//JS
function sortObjects(arr, property, orders) {

    return arr.sort(function(a, b) {

        return orders.indexOf(a[property]) -
               orders.indexOf(b[property]);

    });
}

let students = [
    { name: "Ali", grade: "B" },
    { name: "Vali", grade: "A" },
    { name: "Hasan", grade: "C" }
];

let orders = ["C", "A", "B"];

let result = sortObjects(students, "grade", orders);

document.getElementById("result").innerHTML =
    result.map(student => student.name + " - " + student.grade).join("<br>");
