//JS
function isSorted(arr) {

    for (let i = 0; i < arr.length - 1; i++) {

        if (arr[i] > arr[i + 1]) {
            return false;
        }
    }

    return true;
}

let numbers = [1, 2, 3, 4, 5];

let result = isSorted(numbers);

document.getElementById("result").innerHTML = result;
