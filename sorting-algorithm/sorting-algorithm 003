//JS
function heapSort(arr) {

    function heapify(n, i) {
        let largest = i;
        let left = i * 2 + 1;
        let right = i * 2 + 2;

        if (left < n && arr[left] > arr[largest]) {
            largest = left;
        }

        if (right < n && arr[right] > arr[largest]) {
            largest = right;
        }

        if (largest != i) {
            let temp = arr[i];
            arr[i] = arr[largest];
            arr[largest] = temp;

            heapify(n, largest);
        }
    }

    for (let i = Math.floor(arr.length / 2) - 1; i >= 0; i--) {
        heapify(arr.length, i);
    }

    for (let i = arr.length - 1; i > 0; i--) {
        let temp = arr[0];
        arr[0] = arr[i];
        arr[i] = temp;

        heapify(i, 0);
    }

    return arr;
}

let numbers = [5, 2, 8, 1, 3];

document.getElementById("result").innerHTML = heapSort(numbers);
