//JS

let node1 = { value: 10, next: null };
let node2 = { value: 20, next: null };
let node3 = { value: 30, next: null };

node1.next = node2;
node2.next = node3;

let result = node3.value + " → " +
             node2.value + " → " +
             node1.value;

console.log(result);

document.getElementById("result").innerHTML = result;
//SELF
