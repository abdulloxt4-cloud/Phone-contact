<!DOCTYPE html>
<html>
<body>

<h2>Count Nodes</h2>

<p id="result"></p>

<script src="main.js"></script>

</body>
</html>
//JS
let node1 = { value: 10, next: null };
let node2 = { value: 20, next: null };
let node3 = { value: 30, next: null };

node1.next = node2;
node2.next = node3;

let count = 0;
let current = node1;

while (current != null) {
    count++;
    current = current.next;
}

console.log(count);

document.getElementById("result").innerHTML = count;
//SELF
