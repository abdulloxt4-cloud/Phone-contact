//JS
let node1 = { value: 10, next: null };
let node2 = { value: 20, next: null };
let node3 = { value: 30, next: null };

node1.next = node2;
node2.next = node3;

let arr = [];
let current = node1;

while (current) {
    arr.push(current.value);
    current = current.next;
}

console.log(arr);
document.getElementById("result").innerHTML = arr;
