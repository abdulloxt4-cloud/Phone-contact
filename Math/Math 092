//JS

function cubeSteps(num) {

    if (num <= 0) {
        return "Not a positive number!";
    }

    let steps = 0;

    while (num >= 3) {

        num = Math.cbrt(num);

        steps++;

    }

    return steps;
}

console.log(cubeSteps(27));
console.log(cubeSteps(10000));
console.log(cubeSteps(-100));

