//JS

function sumHighest(arr) {

    arr.sort(function(a, b) {
        return b - a;
    });

    return arr[0] + arr[1];
}

console.log(sumHighest([1,2,6,3,4,5,6,7]));
console.log(sumHighest([2,3,4,5]));


