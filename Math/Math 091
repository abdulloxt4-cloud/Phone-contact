//JS

function oddSum(matrix) {

    let sum = 0;

    for (let row of matrix) {

        for (let num of row) {

            if (num % 2 != 0) {

                sum += num;

            }

        }

    }

    return sum;
}

console.log(oddSum([
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]));

console.log(oddSum([
    [-1, -2],
    [-4, -5]
]));
