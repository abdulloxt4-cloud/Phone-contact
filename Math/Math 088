//JS

function orthogonal(a, b) {

    let sum = 0;

    for (let i = 0; i < a.length; i++) {

        sum += a[i] * b[i];

    }

    return sum == 0;
}

console.log(orthogonal([2,4,1], [2,1,-8]));
console.log(orthogonal([1,0,1], [0,0,1]));
console.log(orthogonal([1,0,0], [0,1,0]));

