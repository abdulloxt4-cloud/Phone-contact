//JS

function isPrime(num) {

    for (let i = 2; i < num; i++) {

        if (num % i == 0) {
            return false;
        }

    }

    return true;
}

function twinPrime(num) {

    if (isPrime(num + 2)) {
        return num + 2;
    }

    if (isPrime(num - 2)) {
        return num - 2;
    }

    return "Twin Prime yo'q";
}

console.log(twinPrime(41));


