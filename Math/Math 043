//JS

function prime(number) {

    for (let i = 2; i <= number; i++) {

        let count = 0;

        for (let a = 1; a <= i; a++) {

            if (i % a == 0) {
                count++;
            }

        }

        if (count == 2) {
            console.log(i);
        }

    }

}

prime(15);


