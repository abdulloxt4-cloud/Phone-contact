//JS

function excelTitle(n) {

    let result = "";

    while (n > 0) {

        n--;

        result = String.fromCharCode((n % 26) + 65) + result;

        n = Math.floor(n / 26);

    }

    return result;
}

console.log(excelTitle(4));
console.log(excelTitle(27));
console.log(excelTitle(151));



