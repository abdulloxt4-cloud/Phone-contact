//JS


function pythagorean(a, b) {
    return Math.sqrt(
        Math.pow(a, 2) + Math.pow(b, 2)
    );
}

console.log(pythagorean(4, 3));


//OZIM UCHUN 
a = 4
b = 3

Math.pow(4,2)
→ 4² = 16

Math.pow(3,2)
→ 3² = 9

16 + 9 = 25

Math.sqrt(25)
→ 5
