//JS

function isPrime(num) {

    if (num < 2) return false;

    for (let i = 2; i < num; i++) {

        if (num % i == 0) {
            return false;
        }

    }

    return true;
}

function allPrime(n) {

    for (let i = 2; i < n; i++) {

        if (isPrime(i)) {
            console.log(i);
        }

    }
}

allPrime(15);


