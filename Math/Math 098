//JS

function columnNumber(text) {

    let result = 0;

    for (let i = 0; i < text.length; i++) {

        result = result * 26 + (text.charCodeAt(i) - 64);

    }

    return result;
}

console.log(columnNumber("C"));
console.log(columnNumber("AD"));
console.log(columnNumber("ZX"));

