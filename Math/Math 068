//JS

function sumDigits(num) {

    let sum = 0;

    let numbers = num.toString();

    for (let i = 0; i < numbers.length; i++) {

        sum = sum + Number(numbers[i]);

    }

    return sum;
}

console.log(sumDigits(6098));


