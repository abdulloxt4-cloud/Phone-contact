//JS

function subtract(a, b) {

    while (b != 0) {

        let borrow = (~a) & b;

        a = a ^ b;

        b = borrow << 1;

    }

    return a;
}

console.log(subtract(200, 100));
console.log(subtract(200, 300));
console.log(subtract(-200, -300));
console.log(subtract(200, 200));

