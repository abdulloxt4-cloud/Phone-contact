//JS

function trailingZeroes(n) {

    let count = 0;

    while (n >= 5) {

        n = Math.floor(n / 5);

        count += n;

    }

    return count;
}

console.log(trailingZeroes(4));
console.log(trailingZeroes(9));
console.log(trailingZeroes(10));
console.log(trailingZeroes(23));
console.log(trailingZeroes(35));


