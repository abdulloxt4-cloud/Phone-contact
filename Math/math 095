//JS

function getChars(text) {

    let words = text.split(" ");

    let result = [];

    for (let word of words) {

        if (word.length % 2 == 0) {

            result.push(word[word.length - 1]);

        } else {

            result.push(word[Math.floor(word.length / 2)]);

        }

    }

    return result.join(", ");
}

console.log(getChars("Number of even numbers and their sum"));

console.log(getChars("JavaScript Math and Numbers- Exercises Practice Solution"));


