//JS

function middle(text) {

    let len = text.length;

    if (len % 2 == 0) {

        return text.slice(len / 2 - 1, len / 2 + 1);

    } else {

        return text.slice(len / 2, len / 2 + 1);

    }

}

console.log(middle("abcd"));
console.log(middle("abc"));
console.log(middle("JavaScript"));

