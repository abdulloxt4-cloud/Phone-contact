//JS

function diagonalSum(matrix) {

    let sum = 0;
    for (let i = 0; i < matrix.length; i++) {

        sum += matrix[i][i];

    }

    return sum;
}

console.log(diagonalSum([
    [1,2,3],
    [4,5,6],
    [7,8,9]
]));

console.log(diagonalSum([
    [-1,-2],
    [-4,-5]
]));

