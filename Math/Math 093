function downward(arr) {

    for (let i = 0; i < arr.length - 1; i++) {

        if (arr[i] <= arr[i + 1]) {

            return false;

        }

    }

    return true;
}

console.log(downward([1,3,4,7,9,10,11]));
console.log(downward([11,10,9,7,4,3,2,0]));
