//JS

function multiplyDigits(num) {

    let str = num.toString();

    let result = "";

    for (let i = 0; i < str.length; i++) {

        let digit = Number(str[i]);

        result += digit * digit * digit;

    }

    return result;
}

console.log(multiplyDigits(11));
console.log(multiplyDigits(66));
console.log(multiplyDigits(336));
console.log(multiplyDigits(444));
console.log(multiplyDigits(1151));


