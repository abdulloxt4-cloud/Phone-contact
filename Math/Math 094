//JS

function evenOdd(arr) {

    let evenCount = 0;
    let evenSum = 0;

    let oddCount = 0;
    let oddSum = 0;

    for (let num of arr) {

        if (num % 2 == 0) {

            evenCount++;
            evenSum += num;

        } else {

            oddCount++;
            oddSum += num;

        }

    }

    console.log(evenCount, evenSum, oddCount, oddSum);

