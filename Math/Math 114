//JS
function selfDividing(num) {

    let str = num.toString();

    for (let digit of str) {

        digit = Number(digit);

        if (digit == 0 || num % digit != 0) {

            return false;

        }

    }

    return true;
}

console.log(selfDividing(48));
console.log(selfDividing(22));
console.log(selfDividing(63));


