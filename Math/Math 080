//JS

function repdigit(num) {

    let str = num.toString();

    for (let i = 1; i < str.length; i++) {

        if (str[i] != str[0]) {
            return false;
        }

    }

    return true;
}


console.log(repdigit(11));
console.log(repdigit(66));
console.log(repdigit(336));
console.log(repdigit(444));
console.log(repdigit(1151));

