//JS

function ugly(num) {

    while (num % 2 == 0) {
        num /= 2;
    }

    while (num % 3 == 0) {
        num /= 3;
    }

    while (num % 5 == 0) {
        num /= 5;
    }

    return num == 1;
}

console.log(ugly(12));
console.log(ugly(18));
console.log(ugly(19));

