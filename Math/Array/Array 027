//JS
function getValues(arr, property) {
    return arr.map(function(item) {
        return item[property];
    });
}

let people = [
    { name: "Ali", age: 15 },
    { name: "Vali", age: 16 },
    { name: "Hasan", age: 17 }
];

let result = getValues(people, "name");

console.log(result);

document.getElementById("result").innerHTML = result;

