//JS
function rangeBetween(start, end) {
    let result = [];

    for (let i = start; i <= end; i++) {
        result.push(i);
    }

    return result;
}

let result = rangeBetween(4, 7);

console.log(result);

document.getElementById("result").innerHTML = result;

