//JS
function remove_array_element(arr, element) {
    return arr.filter(function(item) {
        return item !== element;
    });
}

let arr = [2, 5, 9, 6];

let result = remove_array_element(arr, 5);

console.log(result);

document.getElementById("result").innerHTML = result;

