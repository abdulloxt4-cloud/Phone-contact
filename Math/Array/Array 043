//JS
function unzip(arr) {
    let result = [];

    for (let i = 0; i < arr[0].length; i++) {
        let group = [];

        for (let item of arr) {
            if (item[i] !== undefined) {
                group.push(item[i]);
            }
        }

        result.push(group);
    }

    return result;
}

let result = unzip([
    ["a", 1, true],
    ["b", 2, false]
]);

console.log(result);

document.getElementById("result").innerHTML = result;

