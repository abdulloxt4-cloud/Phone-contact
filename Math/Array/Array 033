//JS
function emptyArray(arr) {
    let newArray = arr.slice();

    newArray.length = 0;

    return newArray;
}

let arr = [1, 2, 3, 4];

let result = emptyArray(arr);

console.log(result);
console.log(arr);

document.getElementById("result").innerHTML = result;
