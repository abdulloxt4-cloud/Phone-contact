//JS

let colors = ["Blue", "Green", "Red", "Orange", "Violet", "Indigo", "Yellow"];

let order = ["th", "st", "nd", "rd"];

for (let i = 0; i < colors.length; i++) {

    let ending;

    if (i == 0) {
        ending = order[1];
    } else if (i == 1) {
        ending = order[2];
    } else if (i == 2) {
        ending = order[3];
    } else {
        ending = order[0];
    }

    console.log((i + 1) + ending + " choice is " + colors[i]);
}

//OZIM UCHUN

colors → Ranglar Arrayi

order → Qo'shimchalar (st, nd, rd, th)

i → Index

ending → Tartib qo'shimchasi

colors[i] → Hozirgi rang

i + 1 → Tartib raqami
