//JS
function sumNumbers(arr) {
    let sum = 0;

    for (let item of arr) {
        if (typeof item === "number") {
            sum += item;
        }
    }

    return sum;
}

let numbers = [2, "11", 3, "a2", false, 5, 7, 1];

let result = sumNumbers(numbers);

console.log(result);

document.getElementById("result").innerHTML = result;
