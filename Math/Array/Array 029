//JS
function num_string_range(start, end, step) {
    let result = [];

    for (
        let i = start.charCodeAt(0);
        i <= end.charCodeAt(0);
        i += step
    ) {
        result.push(String.fromCharCode(i));
    }

    return result;
}

let result = num_string_range("a", "z", 2);

console.log(result);

document.getElementById("result").innerHTML = result;

