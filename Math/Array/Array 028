//JS
function longestCommon(arr) {
    let word = arr[0];

    for (let i = 1; i < arr.length; i++) {
        while (!arr[i].startsWith(word)) {
            word = word.slice(0, -1);
        }
    }

    return word;
}

let result = longestCommon(["go", "google"]);

console.log(result);

document.getElementById("result").innerHTML = result;

