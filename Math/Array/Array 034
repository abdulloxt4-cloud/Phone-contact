//JS
function nthlargest(arr, n) {
    let numbers = arr.slice();

    numbers.sort((a, b) => b - a);

    return numbers[n - 1];
}

let arr = [43, 56, 23, 89, 88, 90, 99, 652];

let result = nthlargest(arr, 4);

console.log(result);

document.getElementById("result").innerHTML = result;
