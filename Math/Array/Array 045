//JS
function unique(arr) {
    let result = [];

    for (let item of arr) {
        if (!result.includes(item)) {
            result.push(item);
        }
    }

    return result;
}

let result = unique([1, 2, 2, 3, 4, 4, 5]);

console.log(result);

document.getElementById("result").innerHTML = result;


