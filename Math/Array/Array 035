//JS
function randomItem(arr) {
    let index = Math.floor(Math.random() * arr.length);

    return arr[index];
}

let arr = ["Ali", "Vali", "Hasan"];

let result = randomItem(arr);

console.log(result);

document.getElementById("result").innerHTML = result;

