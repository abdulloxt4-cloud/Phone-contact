//JS
function indexOn(arr) {
    let result = {};

    for (let item of arr) {
        let id = item.id;

        let value = {
            name: item.name
        };

        result[id] = value;
    }

    return result;
}

let result = indexOn([
    { id: 10, name: "apple" },
    { id: 20, name: "orange" }
]);

console.log(result);

