//JS
function thirdSmallest(arr) {
    arr.sort((a, b) => a - b);

    return arr[2];
}

let numbers = [2, 3, 5, 7, 1];

let result = thirdSmallest(numbers);

console.log(result);

document.getElementById("result").innerHTML = result;
