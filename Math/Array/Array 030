//JS
function merge_array(arr1, arr2) {
    let result = arr1.slice();

    for (let item of arr2) {
        if (!result.includes(item)) {
            result.push(item);
        }
    }

    return result;
}

let array1 = [1, 2, 3];
let array2 = [2, 30, 1];

console.log(merge_array(array1, array2));

document.getElementById("result").innerHTML =
    merge_array(array1, array2);

