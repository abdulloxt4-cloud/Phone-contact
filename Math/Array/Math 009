//JS
let text = "The Quick Brown Fox";

let result = "";

for (let i = 0; i < text.length; i++) {

    if (text[i] == text[i].toUpperCase()) {
        result += text[i].toLowerCase();
    } else {
        result += text[i].toUpperCase();
    }

}

console.log(result);

//OZIM UCHUN
Swap Case → Katta/kichik harfni almashtirish

String → Matn

Character → Belgi

toUpperCase() → Katta harf qilish

toLowerCase() → Kichik harf qilish

if → Tekshirish

