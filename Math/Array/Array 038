//JS
function move(arr, from, to) {
    let item = arr.splice(from, 1)[0];

    arr.splice(to, 0, item);

    return arr;
}

console.log(move([10, 20, 30, 40, 50], 0, 2));
console.log(move([10, 20, 30, 40, 50], -1, -2));

