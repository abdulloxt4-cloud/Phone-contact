//JS
let fruits = ["Apple", "Banana", "apple", "Orange", "banana"];

let newArray = [];

for (let fruit of fruits) {

    let lowerFruit = fruit.toLowerCase();

    if (!newArray.includes(lowerFruit)) {
        newArray.push(lowerFruit);
    }

}

console.log(newArray);

