//JS
function difference(arr1, arr2) {
    let result = [];

    let all = arr1.concat(arr2);

    for (let item of all) {
        if (!result.includes(item)) {
            result.push(item);
        }
    }

    return result;
}

let result = difference([1, 2, 3], [100, 2, 1, 10]);

console.log(result);

document.getElementById("result").innerHTML = result;

