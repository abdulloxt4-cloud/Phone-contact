//JS

function triangularNumber(n) {

    return n * (n + 1) / 2;

}

console.log(triangularNumber(1));
console.log(triangularNumber(2));
console.log(triangularNumber(3));
console.log(triangularNumber(7));
console.log(triangularNumber(11));

