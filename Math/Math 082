//JS

function meanDigits(num) {

    let str = num.toString();

    let sum = 0;

    for (let i = 0; i < str.length; i++) {

        sum += Number(str[i]);

    }

    return sum / str.length;
}

console.log(meanDigits(11));
console.log(meanDigits(66));
console.log(meanDigits(336));
console.log(meanDigits(444));
console.log(meanDigits(1151));



