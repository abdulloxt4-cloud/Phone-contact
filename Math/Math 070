//JS

function rpn(text) {

    let arr = text.split(" ");

    let a = Number(arr[0]);
    let b = Number(arr[1]);
    let op = arr[2];

    if (op == "+") {
        return a + b;
    }
    else if (op == "-") {
        return a - b;
    }
    else if (op == "*") {
        return a * b;
    }
    else if (op == "/") {
        return a / b;
    }
    else {
        return "Noto'g'ri operator";
    }

}

console.log(rpn("3 4 +"));
console.log(rpn("5 2 *"));
console.log(rpn("8 3 -"));
console.log(rpn("6 2 /"));


