//JS

function divisibleSum(x, y, n) {

    let sum = 0;

    for (let i = x; i <= y; i++) {

        if (i % n == 0) {

            sum += i;

        }

    }

    return sum;
}

console.log(divisibleSum(1, 5, 3));
console.log(divisibleSum(100, 1000, 5));


