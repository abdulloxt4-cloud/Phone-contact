//JS
let str = "dog";
let result = [];

for (let i = 0; i < str.length; i++) {
    for (let j = i + 1; j <= str.length; j++) {
        result.push(str.slice(i, j));
    }
}

document.getElementById("result").innerHTML = result;
//SELF
str → "dog"

i → boshlanish indexi

j → tugash joyi

slice(i, j) → stringning kerakli qismini oladi

push() → topilgan qismni result arrayiga qo‘shadi

length → string uzunligini beradi
string → matn

