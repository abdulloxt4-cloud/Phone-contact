//JS
function parseURL(url) {
    let link = new URL(url);

    return {
        protocol: link.protocol,
        host: link.host,
        pathname: link.pathname,
        search: link.search,
        hash: link.hash
    };
}

let result = parseURL("https://example.com:8080/path/page.html?name=Ali#about");

document.getElementById("result").innerHTML =
    "Protocol: " + result.protocol + "<br>" +
    "Host: " + result.host + "<br>" +
    "Path: " + result.pathname + "<br>" +
    "Search: " + result.search + "<br>" +
    "Hash: " + result.hash;
