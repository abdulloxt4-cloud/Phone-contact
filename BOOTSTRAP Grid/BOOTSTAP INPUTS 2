3. Input Group + Button
<div class="input-group">

    <input type="text"
           class="form-control"
           placeholder="Search">

    <div class="input-group-btn">

        <button class="btn btn-default" type="submit">
            <i class="glyphicon glyphicon-search"></i>
        </button>
    </div>
</div>
