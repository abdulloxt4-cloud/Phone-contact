<!DOCTYPE html>
<html>
<head>
    <title>Validate Null</title>
</head>
<body>

    <h2>Validate Null</h2>

    <button onclick="checkNull()">Check</button>

    <p id="result"></p>

    <script src="main.js"></script>
</body>
</html>
//JS
function checkNull() {
    let value = null;

    let result = value == null;

    document.getElementById("result").innerHTML = result;
}
