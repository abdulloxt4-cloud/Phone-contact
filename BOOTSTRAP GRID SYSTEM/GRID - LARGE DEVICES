<!DOCTYPE html>
<html lang="uz">

<head>
    <title>Bootstrap Large Devices</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <div class="container-fluid">

        <h1>Hello World!</h1>

        <div class="row">

            <div class="col-sm-3 col-md-6 col-lg-4">
                <div class="p-3 border">
                    <h3>Box 1</h3>
                    <p>Lorem ipsum...</p>
                </div>
            </div>

            <div class="col-sm-9 col-md-6 col-lg-8">
                <div class="p-3 border">
                    <h3>Box 2</h3>
                    <p>Sed ut perspiciatis...</p>
                </div>
            </div>

        </div>

        <button id="btn" class="btn btn-primary mt-4">
            Ekran holatini tekshirish
        </button>

        <p id="result" class="mt-3"></p>

    </div>

    <script src="main.js"></script>

</body>

</html>
//JS
const btn = document.getElementById("btn");
const result = document.getElementById("result");

btn.addEventListener("click", function () {

    const width = window.innerWidth;

    if (width < 768) {

        result.textContent =
            "Extra small: 100% / 100%";

    } else if (width < 992) {

        result.textContent =
            "Small: 25% / 75%";

    } else if (width < 1200) {

        result.textContent =
            "Medium: 50% / 50%";

    } else {

        result.textContent =
            "Large: 33.3% / 66.6%";

    }

});
//SELF
XS       → 100% / 100%
SM       → 3 + 9 = 25% / 75%
MD       → 6 + 6 = 50% / 50%
LG       → 4 + 8 = 33.3% / 66.6%
col-sm-3
   ↓
small ekranda 3/12

col-md-6
   ↓
medium ekranda 6/12

col-lg-4
   ↓
large ekranda 4/12
