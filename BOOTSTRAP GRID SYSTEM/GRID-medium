<!DOCTYPE html>
<html lang="uz">

<head>
    <title>Bootstrap Medium Devices</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <div class="container-fluid">

        <h1>Hello World!</h1>

        <div class="row">

            <div class="col-sm-3 col-md-6">
                <div class="p-3 border">
                    <h3>Box 1</h3>
                    <p>Lorem ipsum...</p>
                </div>
            </div>

            <div class="col-sm-9 col-md-6">
                <div class="p-3 border">
                    <h3>Box 2</h3>
                    <p>Sed ut perspiciatis...</p>
                </div>
            </div>

        </div>

        <button id="btn" class="btn btn-primary mt-4">
            Ekran o'lchamini tekshirish
        </button>

        <p id="result" class="mt-3"></p>

    </div>

    <script src="main.js"></script>

</body>

</html>
//JS
const btn = document.getElementById("btn");
const result = document.getElementById("result");

btn.addEventListener("click", function () {

    const width = window.innerWidth;

    if (width < 768) {

        result.textContent =
            "Extra small: columnlar 100% / 100%.";

    } else if (width < 992) {

        result.textContent =
            "Small: columnlar 25% / 75%.";

    } else {

        result.textContent =
            "Medium yoki katta: columnlar 50% / 50%.";

    }

});
//SELF
xs → <768px
sm → ≥768px
md → ≥992px
lg → ≥1200px
col-sm-3 + col-sm-9
       ↓
     25 / 75

col-md-6 + col-md-6
       ↓
     50 / 50
