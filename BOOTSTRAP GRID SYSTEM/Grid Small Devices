<!DOCTYPE html>
<html lang="uz">
<head>
    <title>Bootstrap Small Devices</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <div class="container-fluid">

        <h1>Hello World!</h1>

        <!-- 25% / 75% -->
        <div class="row">

            <div class="col-sm-3">
                <div class="p-3 border">
                    <h3>Box 1</h3>
                    <p>Lorem ipsum...</p>
                </div>
            </div>

            <div class="col-sm-9">
                <div class="p-3 border">
                    <h3>Box 2</h3>
                    <p>Sed ut perspiciatis...</p>
                </div>
            </div>

        </div>

        <br>

        <!-- 33.3% / 66.6% -->
        <div class="row">

            <div class="col-sm-4">
                <div class="p-3 border">
                    <h3>Box 3</h3>
                    <p>33.3%</p>
                </div>
            </div>

            <div class="col-sm-8">
                <div class="p-3 border">
                    <h3>Box 4</h3>
                    <p>66.6%</p>
                </div>
            </div>

        </div>

        <button id="btn" class="btn btn-primary mt-4">
            Ekran o'lchamini tekshirish
        </button>

        <p id="result" class="mt-3"></p>

    </div>

    <script src="main.js"></script>

</body>
</html>
//JS
const btn = document.getElementById("btn");
const result = document.getElementById("result");

btn.addEventListener("click", function () {

    const width = window.innerWidth;

    if (width < 768) {
        result.textContent =
            "Extra small ekran: columnlar pastma-past joylashadi.";
    } else {
        result.textContent =
            "Small yoki undan katta ekran: 25% / 75% layout ishlaydi.";
    }

});
//SELF
col-sm-3 + col-sm-9 = 25% / 75%
col-sm-4 + col-sm-8 = 33.3% / 66.6%
col-sm-6 + col-sm-6 = 50% / 50%
sm → 768px dan boshlab

3 → 12 ning 3 qismi = 25%

9 → 12 ning 9 qismi = 75%
sm = 768px dan boshlab
