<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Bootstrap Grid Examples</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <div class="container">

        <h2>Three Equal Columns</h2>

        <div class="row">
            <div class="col-sm-4 border p-3">Column 1</div>
            <div class="col-sm-4 border p-3">Column 2</div>
            <div class="col-sm-4 border p-3">Column 3</div>
        </div>


        <h2 class="mt-4">Three Unequal Columns</h2>

        <div class="row">
            <div class="col-sm-3 border p-3">25%</div>
            <div class="col-sm-6 border p-3">50%</div>
            <div class="col-sm-3 border p-3">25%</div>
        </div>


        <h2 class="mt-4">Two Unequal Columns</h2>

        <div class="row">
            <div class="col-sm-4 border p-3">33.3%</div>
            <div class="col-sm-8 border p-3">66.6%</div>
        </div>


        <button id="btn" class="btn btn-primary mt-4">
            Grid ma'lumotini ko'rsatish
        </button>

        <p id="result" class="mt-3"></p>

    </div>

    <script src="main.js"></script>

</body>

</html>
//JS
const btn = document.getElementById("btn");
const result = document.getElementById("result");

btn.addEventListener("click", function () {

    result.textContent =
        "Bootstrap Grid 12 ta column asosida ishlaydi.";

});
