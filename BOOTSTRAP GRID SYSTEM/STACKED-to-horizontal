<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Stacked to Horizontal</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <div class="container">

        <h1>Hello World!</h1>

        <div class="row">

            <div class="col-sm-6">
                <div class="p-3 border">
                    <h3>Box 1</h3>
                    <p>Lorem ipsum...</p>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="p-3 border">
                    <h3>Box 2</h3>
                    <p>Sed ut perspiciatis...</p>
                </div>
            </div>

        </div>

    </div>

    <script src="main.js"></script>

</body>
</html>
//JS
const btn = document.getElementById("btn");
const result = document.getElementById("result");

btn.addEventListener("click", function () {

    if (window.innerWidth < 768) {
        result.textContent = "Kichik ekran: Boxlar pastma-past joylashgan.";
    } else {
        result.textContent = "Katta ekran: Boxlar yonma-yon joylashgan.";
    }

});
//SELF
container → quti
row → qator
col-sm-6 → 6/12 = 50%
2 ta col-sm-6 → 6 + 6 = 12
sm dan kichik → pastma-past
sm va undan katta → yonma-yon
