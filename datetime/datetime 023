  //JS
  function english_ordinal_suffix(date) {
    let day = date.getDate();

    if (day == 1) return "1st";
    if (day == 2) return "2nd";
    if (day == 3) return "3rd";

    return day + "th";
}

let dt = new Date(2015, 10, 1);

console.log(english_ordinal_suffix(dt));
