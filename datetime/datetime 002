  //JS
  function curday(separator) {
    let date = new Date();

    return (date.getMonth() + 1) + separator +
           date.getDate() + separator +
           date.getFullYear();
}

console.log(curday('/'));
console.log(curday('-'));
//SELF
new Date()       → hozirgi sana
getMonth()       → oy
getDate()        → kun
getFullYear()    → yil
separator        → / yoki -
