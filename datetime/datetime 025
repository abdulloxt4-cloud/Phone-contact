  //JS
  function full_month(date) {
    let months = [
        "January", "February", "March",
        "April", "May", "June",
        "July", "August", "September",
        "October", "November", "December"
    ];

    return months[date.getMonth()];
}

let dt = new Date(2015, 10, 1);

console.log(full_month(dt));
