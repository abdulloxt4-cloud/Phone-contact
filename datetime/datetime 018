  //JS
  function calculate_age(birth) {
    let today = new Date();

    return today.getFullYear() - birth.getFullYear();
}

console.log(calculate_age(new Date(1982, 11, 4)));
console.log(calculate_age(new Date(1962, 1, 1)));

