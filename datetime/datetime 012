  //JS
  function min_date(dates) {
    let min = new Date(dates[0]);

    for (let date of dates) {
        if (new Date(date) < min) {
            min = new Date(date);
        }
    }

    return min;
}

console.log(min_date([
    '2015/02/01',
    '2015/02/02',
    '2015/01/03'
]));
