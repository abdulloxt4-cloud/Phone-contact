  //JS
  function internet_time(date) {
    let seconds = date.getHours() * 3600;
    seconds += date.getMinutes() * 60;
    seconds += date.getSeconds();

    return Math.floor(seconds / 86.4);
}

let dt = new Date(1989, 10, 1);

console.log(internet_time(dt));
