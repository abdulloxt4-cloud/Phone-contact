  //JS
  function hours_with_zeroes(date) {
    let hour = date.getHours();

    if (hour == 0) {
        hour = 12;
    }

    if (hour > 12) {
        hour = hour - 12;
    }

    return String(hour).padStart(2, "0");
}

let dt = new Date(1989, 10, 1);

console.log(hours_with_zeroes(dt));

