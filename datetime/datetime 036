  //JS
  function seconds_with_leading_zeros(date) {
    return String(date.getSeconds()).padStart(2, "0");
}

let dt = new Date(1989, 10, 1);

console.log(seconds_with_leading_zeros(dt));

//SELF
getHours()   → soat
getMinutes() → minut
getSeconds() → sekund
padStart()   → 2 xonali qiladi
0  → "00"
5  → "05"
9  → "09"
15 → "15"
59 → "59"
